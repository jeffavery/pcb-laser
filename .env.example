# Session cookies should be secure on an HTTPS-only public deployment.
PCB_SECURE_COOKIES=yes

# Optional registration-notification email delivery.
# The notification recipient is selected later in the Admin page.
PCB_SMTP_HOST=
PCB_SMTP_PORT=587
PCB_SMTP_TLS=yes
PCB_SMTP_USER=
PCB_SMTP_PASSWORD=
PCB_SMTP_FROM=
